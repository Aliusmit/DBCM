# ========================================================
# DBCM Study Material Platform - .gitignore
# ========================================================

# Dependencies
node_modules/
jspm_packages/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem

# Uploaded Files & User Content (preserve the directory structure with .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editor Directories
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Runtime data & Lock files
pids/
*.pid
*.seed
*.pid.lock
.npm/

# Testing and Coverage
coverage/
.nyc_output/

# Temporary / Scratch Files
tmp/
temp/
scratch/
